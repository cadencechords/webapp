    "e2e:catalog": "playwright test -c e2e/playwright.config.mts --project=catalog",
    "e2e:smoke": "playwright test -c e2e/playwright.config.mts --project=smoke",
    "e2e:unit": "node --test e2e/*.test.mts",
    "preview": "vite preview",
    "tokens:color": "vite-node --options.deps.inline=@material/material-color-utilities scripts/generate-color-tokens.mts",
