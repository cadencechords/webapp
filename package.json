    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:hooks": "node --test .claude/hooks/require-adversarial-review.test.mts",
    "test:unit": "vitest run"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
