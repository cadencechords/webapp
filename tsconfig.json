{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "allowUnreachableCode": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": [
      "vite/client",
      "vite-plugin-svgr/client",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "skipLibCheck": true,
    // react-toastify 9 ships types, but its package.json "exports" has no
    // "types" condition, so bundler resolution can't find them.
    // react-colorful 5 is the same.
    "paths": {
      "react-toastify": ["./node_modules/react-toastify/dist/index.d.ts"],
      "react-colorful": ["./node_modules/react-colorful/dist/index.d.ts"]
    },
    "strict": false
  },
  "include": ["src"]
}
