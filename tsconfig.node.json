{
  // All TypeScript outside src (tsconfig.json): scripts, e2e, cypress,
  // .claude hooks, config files. Node runs most of these with its built-in
  // type stripping, which ignores types, so this is what checks them.
  "compilerOptions": {
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "allowUnreachableCode": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx"],
  "exclude": ["src", "node_modules", "build", "public"]
}
