{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*create_pull_request.*|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Checking for an adversarial review"
          }
        ]
      }
    ]
  }
}
